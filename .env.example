# =============================================================================
# 途灵 TripMind —— Docker 部署配置
#
#   cp .env.example .env      # 然后填下面标了「必填」的几项
#   docker compose up -d --build
#
# 这份文件是给 **Docker 部署**用的;裸机(venv + npm run dev)开发请用
# `backend/.env` 与 `frontend/.env`,两者的变量名一致,内容可以照抄。
#
# ⚠️ `.env` 已在 .gitignore 里,不会被提交。
# =============================================================================

# =============================================================================
# 一、必填 —— 不填就起不来或功能不可用
# =============================================================================

# ---------- 大模型(默认:阿里云百炼) ----------
# 换取别的 OpenAI 兼容服务都行,框架按 base_url 自动识别厂商
LLM_MODEL_ID=qwen3.7-plus
LLM_API_KEY=sk-your-llm-api-key-here
# ⚠️ 百炼的兼容入口**要带** /compatible-mode/v1;DeepSeek 则是
#    https://api.deepseek.com(**不带** /v1)。少写这段会 404,报错也不指向这里。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 单次 LLM 调用的超时(秒)。
#
# ⚠️ 这个值不能小。它不是"单次网络请求"那么短:生成一次行程要调 7 次 LLM,
#    其中最后一步 planner 得一次性生成**完整行程 JSON** —— 实测输出
#    7500+ tokens、**耗时 110 秒**,而框架默认值是 60 秒。
#    后果很隐蔽:前 6 次调用全部正常,只有 planner 必然超时,于是
#    "2 日以上的行程永远生成失败",日志里只有一句 Request timed out。
#    (实测：修复前 7 次运行里 6 次失败,唯一成功的一次用了 49.4/60 秒,擦边通过。)
#
# ⚠️ 它还是**整条超时链路**的最内层,和另外两处必须保持 小 < 大 的顺序:
#       backend/.env           LLM_TIMEOUT        180s  ← 本行
#       frontend/src/services/api.ts  默认 axios  300s
#       frontend/nginx.conf   proxy_read_timeout  330s
#    顺序反了就会出现"nginx 先回 504、前端拿不到可读提示"。
#    另外 SDK 的自动重试已在 app/observability/metering.py 里关掉
#    (max_retries=0)—— 否则这里配 180 最坏会变成 180×3=540 秒,
#    直接顶穿 nginx。
LLM_TIMEOUT=180

# 思考模型(通义/百炼系列)的**思维链**开关。默认关。
#
# ⚠️ 这个默认值是实测出来的,不是拍脑袋。同一个"生成一份小 JSON"的请求:
#
#     不传参数(厂商默认开)   输出 3,570 tokens / 47.7 秒
#     LLM_ENABLE_THINKING=false   878 tokens / 12.1 秒
#
#   生成的内容长度几乎一样 —— 也就是说**约 75% 的输出 token 是看不见的
#   推理过程**。而本项目的 LLM 任务都是"把已经查好的事实整理成结构化输出"
#   (景点/天气/酒店由前三个 agent 查,planner 只做排版),不需要推理链。
#
# 换算到真实运行:planner 一步从 84 秒 / 6,240 tokens 降到 32 秒 / 2,583;
# 整趟生成从 **134 秒降到 65 秒**,费用降约 35%。**这比换模型有效得多。**
#
# 只有模型名以 qwen 开头时才会传这个参数,所以换成 DeepSeek / OpenAI 官方
# 接口是安全的(它们不认这个参数,传过去会 400)。详见
# `app/observability/metering.py::thinking_extra_body`。
LLM_ENABLE_THINKING=false

# ---------- 高德地图:两个 Key 用途不同,要分别申请 ----------
# Web **服务** Key —— 后端调 MCP 工具用,属于服务端密钥,**不要**泄露到前端
AMAP_API_KEY=your-amap-web-service-key-here

# Web 端(JS API)Key —— 前端加载地图用。它本来就是公开的(浏览器可见),
# 靠高德控制台的**域名白名单**保护,所以可以放在这里由 compose 注入。
# 留空的话其余功能都正常,只是结果页的地图加载不出来。
VITE_AMAP_WEB_JS_KEY=your-amap-js-api-key-here
# JS API 安全密钥(2021-12 之后申请的 Key 必须配,否则报 INVALID_USER_SCODE)
VITE_AMAP_SECURITY_CODE=

# ---------- 引导管理员账号(可选,但强烈建议在公网部署前设上) ----------
#
# 第一次启动时,如果账号表是**空的**,服务端会用这两项建出第一个管理员。
# 之后启动不会再动任何账号(哪怕你把用户名/密码改成别的 —— 不会被改回来)。
#
# ⚠️ 不配密码的话,默认值是 `admin123` —— 这是**公开仓库里的已知弱口令**。
#    它只在空库时生效一次,但如果你先把服务起来、让别人访问了一会儿才想起改,
#    那个窗口就是敞开的。所以对外部署请务必显式设一个:
#        openssl rand -base64 18
#
# 忘记密码了怎么办(没有"找回密码"入口,这个项目不发邮件):
#     cd backend
#     ./venv/Scripts/python.exe scripts/manage_users.py passwd admin --password-stdin
#
# ⚠️ 两行都**刻意注释掉**:配了空值等于把密码设成空串,会被密码策略拒掉
#    然后回退到 admin/admin123 —— 行为虽然对,但启动日志里会多一条"配置不合法"。
#    不配就是干净的默认值。要用就整行取消注释并填上。
# TRIPMIND_ADMIN_USERNAME=admin
# TRIPMIND_ADMIN_PASSWORD=

# =============================================================================
# 二、可选 —— 不填也能跑
# =============================================================================

# ---------- 端口 ----------
# 前端对外端口。改完访问 http://127.0.0.1:<HTTP_PORT>
HTTP_PORT=8080
# 后端端口只绑在宿主机回环上(127.0.0.1),用于本机调试 /docs
BACKEND_PORT=8001

# ---------- 服务端 ----------
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# 前后端同源(都由 nginx 提供),正常情况下用不到跨域配置。
# 只有把前端单独部署到别的域名时才需要改。
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---------- 景点配图(Unsplash)----------
# 留空只是景点没有配图,不影响其他功能
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# ---------- 登录会话 ----------
# 一次登录能顶多久(小时)。7 天是"不天天输密码"和"令牌泄露的有效窗口"之间的折中。
# 改小更安全、代价是用户更频繁地重新登录。
TRIPMIND_SESSION_TTL_HOURS=168
# 密码最小长度。只要求长度,不强制大小写数字混合 ——
# 复杂度规则会把用户推向 `Passw0rd!` 这类可预测的变体,而强度其实来自长度。
TRIPMIND_PASSWORD_MIN_LENGTH=6

# 自助注册开关。默认开 —— 落地页的「免费开始」直接通向注册接口。
#
# 注册出来的账号**固定是普通用户**,角色不接受客户端传参(写死在代码里);
# 管理员只能由已有管理员在「账号管理」里创建。
# 被刷号、或临时想改成邀请制时改这里,重启生效(关闭后接口回 403)。
TRIPMIND_ALLOW_REGISTRATION=true

# ---------- 数据文件 ----------
# compose 里会把它覆盖成 /data/tripmind.db(命名卷)。
# 这里写的是"不通过 compose 直接 docker run"时的默认值。
# 两种写法都认:TRIPMIND_DB 与 DB_PATH。
TRIPMIND_DB=/data/tripmind.db

# =============================================================================
# 三、知识库(RAG)—— 默认关闭,不开完全不影响主流程
# =============================================================================
# 两种落地方式,按部署环境选一种(详见 docs/DEPLOYMENT.md 第 8 节):
#
# (A) 本地嵌入式(Milvus Lite)—— **单机部署推荐**。不用起任何容器,
#     数据就是命名卷上的一个文件。代价:单进程、规模上限约百万向量级。
#     ENABLE_RAG=true
#     TRIPMIND_MILVUS_URI=/data/tripmind_milvus.db
#
# (B) 远端 Milvus standalone(etcd + minio + milvus 三个容器,占 2~4GB)。
#     后端在容器里,所以要用 host.docker.internal 指向**宿主机**,
#     写 localhost 会指向容器自己。
#     ENABLE_RAG=true
#     MILVUS_URI=http://host.docker.internal:19530
#
# ⚠️ 这两个变量名**不能混用**,不是风格问题:
#    `MILVUS_URI` 是 **pymilvus 自己的**环境变量,它要求值是 http(s) URL。
#    所以 (A) 的本地文件路径**必须**写 `TRIPMIND_MILVUS_URI` ——
#    写进 `MILVUS_URI` 的话,pymilvus 在 import 时就会先抛 `Illegal uri`,
#    根本走不到它自己里面"本地文件 → 起 Lite"那个分支。
#    (config.py 里加了启动期护栏,会把这个错误提前说清楚。)
#    远端部署 (B) 两种写法都认,老部署脚本不用改。

# embedding 与对话模型是两套独立配置
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_API_KEY=sk-your-siliconflow-key-here
EMBED_BASE_URL=https://api.siliconflow.cn/v1
RAG_TOP_K=4

# =============================================================================
# 四、包源(可选,但 UV_INDEX_URL 在国内基本是必需)
# =============================================================================
# 换 pip / npm 源。国外环境改成官方源即可。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com

# ⚠️这项只管 uv,但**不是构建加速** —— 后端起容器后要用 uvx 现装
#    amap-mcp-server,uv 默认从 files.pythonhosted.org 拉 wheel。
#    国内是"能连上但极慢":每个 .metadata 请求要几秒,几十个包装完要
#    好几分钟。而这段时间后端日志里只有一行
#
#        🔗 连接到 MCP 服务器...
#
#    看起来完全像卡死,其实在下包;表现出来就是"第一次点生成行程一直转圈"。
#    换成国内镜像后几秒装完。国外环境改成 https://pypi.org/simple
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
