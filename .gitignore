# ============================================
# 密钥 —— 最重要的一条,绝不能提交
# ============================================
.env
.env.*
!.env.example

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
backend/venv/
venv/
.pytest_cache/
.coverage

# ============================================
# Node / 前端
# ============================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/node_modules/.vite/

# ============================================
# 本地产物(可重新生成,不进仓库)
# ============================================
backend/data/runs/
backend/data/eval/
*.db
*.db-wal
*.db-shm
qdrant_storage/

# ============================================
# 编辑器 / 操作系统
# ============================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================
# 日志
# ============================================
*.log
npm-debug.log*
yarn-error.log*

# 说明:backend/data/frozen/ 和 backend/data/knowledge_base/
# 是评测的 ground truth,属于可复现性的一部分,【不要】忽略
