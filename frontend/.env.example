# ============================================
# 复制本文件为 .env 后填入你自己的密钥
#   cp .env.example .env
# .env 已在 .gitignore 中,不会被提交
#
# 注意:VITE_ 前缀的变量会被打包进前端产物,
#      任何人都能在浏览器里看到。请勿在此放入
#      需要保密的密钥。
# ============================================

# ---------- 后端 API 地址 ----------
# 留空 = 前端发相对路径请求,开发时由 vite proxy 转发到后端
# (目标地址在 vite.config.ts 的 server.proxy 里,默认 http://127.0.0.1:8001)。
# 只有在需要绕过代理直连后端时才填完整地址。
VITE_API_BASE_URL=

# ---------- 高德地图 ----------
# Web服务API Key
VITE_AMAP_WEB_KEY=your-amap-web-service-key-here

# Web端(JS API) Key —— 这个本身就是公开的,需在高德控制台配域名白名单
VITE_AMAP_WEB_JS_KEY=your-amap-js-api-key-here

# JS API 安全密钥(可选,但 2021-12 之后申请的 Key 必须配)
# 不配的话地图会加载失败并报 INVALID_USER_SCODE —— 现象和"Key 填错"完全一样,
# 都表现为地图区域空白,很容易误判。老 Key 不需要,留空即可。
VITE_AMAP_SECURITY_CODE=
