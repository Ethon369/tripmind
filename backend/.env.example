# ============================================
# 复制本文件为 .env 后填入你自己的密钥
#   cp .env.example .env
# .env 已在 .gitignore 中,不会被提交
# ============================================

# ---------- LLM 配置 ----------
# 模型名称
LLM_MODEL_ID=deepseek-flash

# API 密钥(必填)
LLM_API_KEY=sk-your-llm-api-key-here

# 服务地址
LLM_BASE_URL=https://api.deepseek.com

# 超时时间(秒,可选,默认 60)
LLM_TIMEOUT=60

# ---------- 服务器配置 ----------
HOST=0.0.0.0
PORT=8001

# ---------- CORS ----------
# 允许跨域的前端地址,逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- 高德地图(Web服务API Key) ----------
AMAP_API_KEY=your-amap-web-service-key-here

# ---------- Unsplash 图片服务 ----------
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
UNSPLASH_SECRET_KEY=your-unsplash-secret-key-here

# ============================================
# 以下为 RAG 相关配置(可选,不做 RAG 可留空)
# ============================================

# ---------- Embedding 服务 ----------
# 本项目的 LLM(DeepSeek)没有 embedding 接口,需另配一个。
# 这里用硅基流动的 BAAI/bge-m3(免费,1024 维,OpenAI 兼容)。
#
# 注意:EMBED_MODEL_TYPE 填 dashscope 是因为框架把
#      "OpenAI 兼容 REST" 这条路径实现在 DashScopeEmbedding 类里,
#      与厂商无关。
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_API_KEY=sk-your-siliconflow-key-here
EMBED_BASE_URL=https://api.siliconflow.cn/v1

# ---------- Qdrant 向量库 ----------
# 启动方式:
#   docker run -d --name qdrant -p 6333:6333 -p 6334:6334 \
#     -v "D:/你的路径/qdrant_storage:/qdrant/storage" qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# collection 名带上维度是为了防止"换了 embedding 模型却忘了重建库"
# —— 维度不匹配会让检索静默返回空结果,不报任何错
QDRANT_COLLECTION=trip_kb_1024

# ---------- 本地 SQLite ----------
TRIPMIND_DB=./data/tripmind.db

# ---------- 功能开关 ----------
ENABLE_RAG=false
AGENT_MODE=pipeline
