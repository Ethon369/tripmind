# ============================================
# 复制本文件为 .env 后填入你自己的密钥
#   cp .env.example .env
# .env 已在 .gitignore 中,不会被提交
# ============================================

# ---------- LLM 配置 ----------
# 模型名称
LLM_MODEL_ID=deepseek-flash

# API 密钥(必填)
LLM_API_KEY=sk-your-llm-api-key-here

# 服务地址
LLM_BASE_URL=https://api.deepseek.com

# 超时时间(秒,可选,默认 60)
LLM_TIMEOUT=60

# ---------- 服务器配置 ----------
HOST=0.0.0.0
PORT=8001

# ---------- CORS ----------
# 允许跨域的前端地址,逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- 高德地图(Web服务API Key) ----------
AMAP_API_KEY=your-amap-web-service-key-here

# ---------- Unsplash 图片服务 ----------
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
UNSPLASH_SECRET_KEY=your-unsplash-secret-key-here

# ============================================
# 以下为 RAG 相关配置(可选,不做 RAG 可留空)
# ============================================

# ---------- Embedding 服务 ----------
# 本项目的 LLM(DeepSeek)没有 embedding 接口,需另配一个。
# 这里用硅基流动的 BAAI/bge-m3(免费,1024 维,OpenAI 兼容)。
#
# 注意:EMBED_MODEL_TYPE 填 dashscope 是因为框架把
#      "OpenAI 兼容 REST" 这条路径实现在 DashScopeEmbedding 类里,
#      与厂商无关。
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_API_KEY=sk-your-siliconflow-key-here
EMBED_BASE_URL=https://api.siliconflow.cn/v1

# ---------- Milvus 向量库 ----------
# 本项目**不用**框架自带的 Qdrant 支持:hello_agents 的
# create_rag_pipeline() 里没有 store 注入点,写死了 QdrantVectorStore,
# 要用 Milvus 只能自己写检索层(app/services/knowledge_service.py)。
#
# 启动方式(standalone,需要 Docker):
#   cd /d D:\你的路径\Milvus && docker compose up -d
#   # 健康检查: curl http://127.0.0.1:9091/healthz
#
# ⚠️ Milvus standalone 是三个容器(etcd + minio + milvus),
#    比单容器的 Qdrant 重,首次启动要等 30~60 秒才 healthz 200。
# ⚠️ 容器被**重建**后可能报
#    `InvalidateCollectionMetaCache failed ... node not match`,
#    这是 etcd 里记着旧 proxy 节点 ID。`docker compose down && up -d` 可解
#    (数据在 bind mount 里,down 不会删)。
MILVUS_URI=http://localhost:19530
# collection 名带上维度是为了防止"换了 embedding 模型却忘了重建库"
# —— 维度不匹配时 Milvus 不报错,写入/检索结果会乱,属于静默失败
RAG_COLLECTION_POI=trip_poi_facts_1024
RAG_COLLECTION_GUIDES=trip_city_guides_1024
# 每层检索几条。两层各取这么多,合起来进 prompt
RAG_TOP_K=4

# ---------- 本地 SQLite ----------
TRIPMIND_DB=./data/tripmind.db

# ---------- 功能开关 ----------
# ENABLE_RAG 关掉时 prompt 与加 RAG 之前**逐字相同**,
# 所以开/关两组数字可以直接对比(P7 的验收产物)。
ENABLE_RAG=false
AGENT_MODE=pipeline
