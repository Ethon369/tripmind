# ============================================
# 复制本文件为 .env 后填入你自己的密钥
#   cp .env.example .env
# .env 已在 .gitignore 中,不会被提交
# ============================================

# ---------- LLM 配置 ----------
# 模型名称
LLM_MODEL_ID=deepseek-flash

# API 密钥(必填)
LLM_API_KEY=sk-your-llm-api-key-here

# 服务地址
LLM_BASE_URL=https://api.deepseek.com

# 超时时间(秒,可选,默认 60)
LLM_TIMEOUT=60

# ---------- 服务器配置 ----------
HOST=0.0.0.0
PORT=8000

# ---------- CORS ----------
# 允许跨域的前端地址,逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- 高德地图(Web服务API Key) ----------
AMAP_API_KEY=your-amap-web-service-key-here

# ---------- Unsplash 图片服务 ----------
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
UNSPLASH_SECRET_KEY=your-unsplash-secret-key-here
